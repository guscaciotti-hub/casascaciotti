# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: apenas para scripts administrativos (nunca exposto ao client)
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: habilita o botão "Sugerir categorias com IA"
ANTHROPIC_API_KEY=

# Opcional: aviso por e-mail quando chega recado.
# Sem nenhum destes, o sistema roda inteiro — só não manda e-mail.
# Escolha UM transporte.
#
# Gmail (não precisa de domínio): senha de app em myaccount.google.com/apppasswords
# Codifique o @ do usuário como %40 e a senha sem espaços.
SMTP_URL=smtps://voce%40gmail.com:senhadeapp@smtp.gmail.com:465
# Ou Resend (precisa de domínio verificado para enviar a terceiros)
RESEND_API_KEY=
MAIL_FROM=Casa Scaciotti <avisos@seudominio.com>

# Usado no link dentro do e-mail. Na Vercel é deduzido sozinho.
NEXT_PUBLIC_APP_URL=https://casascaciotti.vercel.app
